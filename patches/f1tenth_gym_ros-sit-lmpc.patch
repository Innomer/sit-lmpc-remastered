diff --git a/config/sim.yaml b/config/sim.yaml
index 3ea76ee..ee7af55 100644
--- a/config/sim.yaml
+++ b/config/sim.yaml
@@ -116,6 +116,16 @@ bridge:
     # If true, the simulation will step using a timer callback.
     async_mode: True
 
+    # How /drive messages are interpreted.
+    # 'speed_steering_angle': drive.speed and drive.steering_angle, tracked by the gym's P controllers (default).
+    # 'accel_steering_speed': drive.acceleration and drive.steering_angle_velocity applied directly
+    # (for acceleration-based controllers such as SIT-LMPC). Keyboard teleop assumes the default mode.
+    control_mode: 'speed_steering_angle'
+
+    # Synchronous mode only: physics steps (of 0.01 s) taken per ego /drive message before odom is
+    # published. 1 = one step per message (default); 10 lets a 10 Hz controller advance 0.1 s per message.
+    substeps_per_drive: 1
