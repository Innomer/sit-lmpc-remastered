+    def condition_callback(self, msg):
+        values = json.loads(msg.data)
+        for name in ("mu", "mass_ratio"):
+            if name in values:
+                self.condition[name] = float(values[name])
+        self.get_logger().info(f'vehicle condition set to {self.condition}')
+        self._apply_condition()
+
+    def zones_callback(self, msg):
+        self.friction_zones = [
+            (float(zone["x_min"]), float(zone["y_min"]), float(zone["x_max"]), float(zone["y_max"]), float(zone["mu"]))
+            for zone in json.loads(msg.data)
+        ]
+        self.get_logger().info(f'{len(self.friction_zones)} friction zones set')
+        self._apply_condition()
+
+    def _apply_condition(self):
+        mu = self.condition["mu"]
+        inside = False
+        for x_min, y_min, x_max, y_max, zone_mu in self.friction_zones:
+            if x_min <= self.ego_pose[0] <= x_max and y_min <= self.ego_pose[1] <= y_max:
+                mu = zone_mu
+                inside = True
+        key = (mu, self.condition["mass_ratio"])
+        if key == self.applied_condition:
+            return
+        base = self.base_vehicle_params
+        params = dataclasses.replace(base, mu=mu, m=float(base.m) * self.condition["mass_ratio"])
+        self.env.update_params(params)
+        self.vehicle_params = params
+        self.applied_condition = key
+        self.zone_active = inside
+        self.condition_pub.publish(String(data=json.dumps({
+            "mu": mu, "mass_ratio": self.condition["mass_ratio"], "in_zone": inside,
+            "sim_time": float(self.env.unwrapped.sim_time),
+        })))
+
+    def _update_sensors(self):
+        s = self.sensor
+        vx, vy, rate = self.ego_speed
+        if self.sensor_previous is None:
+            self.sensor_previous = (vx, vy, rate)
+        pvx, pvy, prate = self.sensor_previous
+        dt = self.sim_timestep
+        accel_x = (vx - pvx) / dt - rate * vy
+        accel_y = (vy - pvy) / dt + rate * vx
+        rate_dot = (rate - prate) / dt
+        accel_x += -rate_dot * s['imu_offset_y'] - rate ** 2 * s['imu_offset_x']
+        accel_y += rate_dot * s['imu_offset_x'] - rate ** 2 * s['imu_offset_y']
+        angle = s['imu_yaw_misalignment']
+        imu_x = math.cos(angle) * accel_x + math.sin(angle) * accel_y + s['accel_bias_x']
+        imu_y = -math.sin(angle) * accel_x + math.cos(angle) * accel_y + s['accel_bias_y']
+        noise = self.sensor_rng.normal(0.0, 1.0, 7)
+        rear = self._cog_to_base_link(list(self.ego_pose))
+        self.pose_history.append(rear)
+        lagged = self.pose_history[0]
+        self.sensor_reading = {
+            'accel_x': imu_x + s['accel_noise'] * noise[0],
+            'accel_y': imu_y + s['accel_noise'] * noise[1],
+            'gyro_z': s['gyro_scale'] * rate + s['gyro_bias'] + s['gyro_noise'] * noise[2],
+            'wheel': s['wheel_scale'] * vx + s['wheel_noise'] * noise[3],
+            'pose_x': lagged[0] + s['pose_noise'] * noise[4],
+            'pose_y': lagged[1] + s['pose_noise'] * noise[5],
+            'pose_yaw': lagged[2] + s['yaw_noise'] * noise[6],
+        }
+        self.sensor_previous = (vx, vy, rate)
+
+    def _publish_sensors(self, ts):
+        reading = self.sensor_reading
+        if reading is None:
+            return
+        imu = Imu()
+        imu.header.stamp = ts
+        imu.header.frame_id = self.ego_namespace + '/base_link'
+        imu.linear_acceleration.x = float(reading['accel_x'])
+        imu.linear_acceleration.y = float(reading['accel_y'])
+        imu.angular_velocity.z = float(reading['gyro_z'])
+        self.imu_pub.publish(imu)
+        wheel = Odometry()
+        wheel.header.stamp = ts
+        wheel.twist.twist.linear.x = float(reading['wheel'])
+        self.wheel_pub.publish(wheel)
+        pose = Odometry()
+        pose.header.stamp = ts
+        pose.header.frame_id = 'map'
+        pose.pose.pose.position.x = float(reading['pose_x'])
+        pose.pose.pose.position.y = float(reading['pose_y'])
+        pose.pose.pose.orientation.z = math.sin(reading['pose_yaw'] / 2)
+        pose.pose.pose.orientation.w = math.cos(reading['pose_yaw'] / 2)
+        self.pf_pub.publish(pose)
